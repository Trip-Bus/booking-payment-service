# Variables de booking-payment-service con valores de QA LOCAL (no son secretos reales).
# Uso: cp .env.example .env   (el .env nunca se sube a git). En PROD los secretos viven solo en el servidor.

# --- Servicio ---
SERVER_PORT=18004

# --- PostgreSQL propia de booking (en Docker el compose cambia host/puerto a booking-db:5432) ---
DB_HOST=localhost
DB_PORT=18104
DB_NAME=tripbus_booking
DB_USERNAME=booking
DB_PASSWORD=booking_qa_pw

# --- Redis compartido, con contraseña (en Docker: redis:6379) ---
REDIS_HOST=localhost
REDIS_PORT=18100
REDIS_PASSWORD=tripbus_redis_qa_pw

# --- Token entre servicios (/internal/**) ---
INTERNAL_API_TOKEN=tripbus_internal_qa_token

# --- Otros servicios (en Docker el compose los cambia a host.docker.internal) ---
IDENTITY_JWKS_URI=http://localhost:18001/.well-known/jwks.json
CATALOG_URL=http://localhost:18002
SEAT_INVENTORY_URL=http://localhost:18003
FLASH_OFFERS_URL=http://localhost:18006

# --- Tiquetes: firma del código QR ---
TICKET_SECRET=tripbus_ticket_qa_secret

# --- Pasarela sandbox: webhook firmado con HMAC-SHA256 (en Docker el compose usa booking-payment-service:18004) ---
PAYMENT_WEBHOOK_URL=http://localhost:18004/webhooks/payment
PAYMENT_WEBHOOK_SECRET=tripbus_webhook_qa_secret

# --- Tiquete por correo (opcional; MAIL_HOST vacío = envío deshabilitado). Para probar local: MailHog/Mailpit en 1025 ---
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=TripBus <no-reply@tripbus.co>
